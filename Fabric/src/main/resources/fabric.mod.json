{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "${mod_credits}"
  ],
  "contact": {
    "homepage": "https://github.com/${mod_author}/${mod_name}",
    "issues": "https://github.com/${mod_author}/${mod_name}/issues",
    "sources": "https://github.com/${mod_author}/${mod_name}"
  },
  "license": "${license}",
  "icon": "${mod_id}_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "technology.roughness.whitenoise.WhiteNoiseFabric"
    ],
    "client": [
      "technology.roughness.whitenoise.WhiteNoiseClientFabric"
    ],
    "preLaunch": [
      "technology.roughness.whitenoise.WhiteNoisePreLaunchFabric"
    ],
    "modmenu": [
      "technology.roughness.whitenoise.integration.ModMenuPlugin"
    ],
    "whitenoise": [
      "technology.roughness.whitenoise.FabricConfigInitializer"
    ]
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ]
    }
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_min_version}",
    "fabric": "*",
    "minecraft": "${fabric_mc_version_range}",
    "java": ">=${java_version}"
  }
}

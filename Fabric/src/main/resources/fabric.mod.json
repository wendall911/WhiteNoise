{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
      "${mod_author}"
    ],
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
      "main": [
        "technology.roughness.whitenoise.WhiteNoiseFabric"
      ],
      "client": [
        "technology.roughness.whitenoise.WhiteNoiseClientFabric"
      ],
      "server": [
        "technology.roughness.whitenoise.WhiteNoiseFabric"
      ],
      "preLaunch": [
        "technology.roughness.whitenoise.WhiteNoisePreLaunchFabric"
      ]
    },
    "mixins": [
      "${mod_id}.mixins.json"
    ],
    "depends": {
      "fabricloader": ">=${fabric_loader_version}",
      "fabric": "*",
      "minecraft": "${fabric_mc_version_range}",
      "java": ">=17"
    }
}
  
